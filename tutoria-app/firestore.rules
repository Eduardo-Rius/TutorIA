rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Rule Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function authorizationContextExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/authorizationContexts/$(request.auth.uid));
    }

    function authorizationContext() {
      return get(/databases/$(database)/documents/authorizationContexts/$(request.auth.uid)).data;
    }

    function hasActiveAuthorizationContext() {
      return authorizationContextExists() && authorizationContext().active == true;
    }

    function hasRole(role) {
      return hasActiveAuthorizationContext() && authorizationContext().institutionalRole == role;
    }

    function isTeacher() {
      return hasRole('TEACHER');
    }

    function isDirector() {
      return hasRole('DIRECTOR');
    }

    function isSupervisor() {
      return hasRole('SUPERVISOR');
    }

    function belongsToDaycare(daycareId) {
      return hasActiveAuthorizationContext() && (daycareId in authorizationContext().authorizedDaycareIds);
    }

    // -------------------------------------------------------------------------
    // Authorization Context Collection (V2)
    // -------------------------------------------------------------------------
    match /authorizationContexts/{authUid} {
      // Users can read their own projection
      allow read: if isSignedIn() && request.auth.uid == authUid;
      
      // Client users MUST NOT elevate their own authorization.
      allow write: if false; 
    }

    // -------------------------------------------------------------------------
    // Users Collection (Legacy V1 - Deprecated)
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Weekly Plannings Collection
    // -------------------------------------------------------------------------
    match /weeklyPlannings/{planningId} {
      
      function isPlanOwner() {
        // TEMPORARY V1 OWNERSHIP COMPATIBILITY
        return resource.data.teacherId == request.auth.uid;
      }
      
      function isNewPlanOwner() {
        // TEMPORARY V1 OWNERSHIP COMPATIBILITY
        return request.resource.data.teacherId == request.auth.uid;
      }

      function isPedagogicalUpdateOnly() {
        // Only allow changes to pedagogical content, not ownership or status fields.
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        return !affected.hasAny(['teacherId', 'daycareId', 'roomId', 'status', 'reviewHistory', 'closedBy', 'closedAt', 'approvedBy', 'approvedAt']);
      }

      function dayHasNoTeacherTampering(newDay, oldDay) {
        // Teacher cannot set evaluationStatus to APPROVED unless it was already APPROVED
        let approvedRetainedOrNotSet = (newDay.get('evaluationStatus', '') != 'APPROVED') ||
          (oldDay != null && oldDay.get('evaluationStatus', '') == 'APPROVED');
          
        // Teacher cannot forge or alter evaluationReviewedBy
        let reviewerUnchanged = (!('evaluationReviewedBy' in newDay)) ||
          (oldDay != null && 'evaluationReviewedBy' in oldDay && newDay.evaluationReviewedBy == oldDay.evaluationReviewedBy);

        // Teacher cannot forge or alter evaluationReviewedAt
        let reviewedAtUnchanged = (!('evaluationReviewedAt' in newDay)) ||
          (oldDay != null && 'evaluationReviewedAt' in oldDay && newDay.evaluationReviewedAt == oldDay.evaluationReviewedAt);

        return approvedRetainedOrNotSet && reviewerUnchanged && reviewedAtUnchanged;
      }

      function daysHaveNoTeacherTampering() {
        let newDays = request.resource.data.days;
        let oldDays = resource.data.days;
        return !(newDays is list) || (
          newDays.size() != 5 ? false : (
            dayHasNoTeacherTampering(newDays[0], (oldDays is list && oldDays.size() == 5) ? oldDays[0] : null) &&
            dayHasNoTeacherTampering(newDays[1], (oldDays is list && oldDays.size() == 5) ? oldDays[1] : null) &&
            dayHasNoTeacherTampering(newDays[2], (oldDays is list && oldDays.size() == 5) ? oldDays[2] : null) &&
            dayHasNoTeacherTampering(newDays[3], (oldDays is list && oldDays.size() == 5) ? oldDays[3] : null) &&
            dayHasNoTeacherTampering(newDays[4], (oldDays is list && oldDays.size() == 5) ? oldDays[4] : null)
          )
        );
      }

      function isTeacherPedagogicalUpdate() {
        return (resource.data.status in ['DRAFT', 'REJECTED'])
          && isPedagogicalUpdateOnly();
      }

      function isTeacherEvaluationUpdate() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.status == 'APPROVED'
          && request.resource.data.status == 'APPROVED'
          && affected.hasOnly(['days', 'version'])
          && !affected.hasAny(['teacherId', 'daycareId', 'roomId', 'status', 'reviewHistory', 'closedBy', 'closedAt', 'approvedBy', 'approvedAt'])
          && daysHaveNoTeacherTampering();
      }

      function dayHasValidDirectorReview(newDay, oldDay) {
        // Director cannot alter core activities during evaluation review
        let activitiesUnchanged = (oldDay == null) || (!('activities' in oldDay)) || (newDay.get('activities', []) == oldDay.activities);

        // Director cannot forge someone else's review identity
        let validReviewer = (!('evaluationReviewedBy' in newDay)) ||
          (oldDay != null && 'evaluationReviewedBy' in oldDay && newDay.evaluationReviewedBy == oldDay.evaluationReviewedBy) ||
          (newDay.evaluationReviewedBy == request.auth.uid);

        return activitiesUnchanged && validReviewer;
      }

      function daysHaveValidDirectorReview() {
        let newDays = request.resource.data.days;
        let oldDays = resource.data.days;
        return !(newDays is list) || (
          newDays.size() != 5 ? false : (
            dayHasValidDirectorReview(newDays[0], (oldDays is list && oldDays.size() == 5) ? oldDays[0] : null) &&
            dayHasValidDirectorReview(newDays[1], (oldDays is list && oldDays.size() == 5) ? oldDays[1] : null) &&
            dayHasValidDirectorReview(newDays[2], (oldDays is list && oldDays.size() == 5) ? oldDays[2] : null) &&
            dayHasValidDirectorReview(newDays[3], (oldDays is list && oldDays.size() == 5) ? oldDays[3] : null) &&
            dayHasValidDirectorReview(newDays[4], (oldDays is list && oldDays.size() == 5) ? oldDays[4] : null)
          )
        );
      }

      function isDirectorPlanningReview() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.status == 'IN_REVIEW'
          && request.resource.data.status in ['APPROVED', 'REJECTED']
          && affected.hasOnly(['status', 'reviewHistory', 'version', 'identifiedNeeds', 'observations', 'approvedBy', 'approvedAt', 'granularObservations', 'historicalRounds']);
      }

      function isDirectorEvaluationReview() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.status == 'APPROVED'
          && request.resource.data.status == 'APPROVED'
          && affected.hasOnly(['days', 'version'])
          && daysHaveValidDirectorReview();
      }

      function isAllDailyEvaluationsApproved(days) {
        return days is list && days.size() == 5 &&
          days[0].get('evaluationStatus', '') == 'APPROVED' &&
          days[1].get('evaluationStatus', '') == 'APPROVED' &&
          days[2].get('evaluationStatus', '') == 'APPROVED' &&
          days[3].get('evaluationStatus', '') == 'APPROVED' &&
          days[4].get('evaluationStatus', '') == 'APPROVED';
      }

      function isDirectorWeekClosure() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.status == 'APPROVED'
          && request.resource.data.status == 'CLOSED'
          && affected.hasOnly(['status', 'closedBy', 'closedAt', 'version'])
          && request.resource.data.closedBy == request.auth.uid
          && ('closedAt' in request.resource.data)
          && isAllDailyEvaluationsApproved(resource.data.days);
      }

      allow read: if isSignedIn() && (
        (isTeacher() && isPlanOwner() && belongsToDaycare(resource.data.daycareId)) ||
        (isDirector() && belongsToDaycare(resource.data.daycareId)) ||
        (isSupervisor() && belongsToDaycare(resource.data.daycareId) && (resource.data.status in ['APPROVED', 'CLOSED']))
      );

      allow create: if isSignedIn() && isTeacher() && isNewPlanOwner() && belongsToDaycare(request.resource.data.daycareId);

      allow update: if isSignedIn() 
        && resource.data.status != 'CLOSED'
        && resource.data.daycareId == request.resource.data.daycareId
        && (
          (
            isTeacher() 
            && isPlanOwner() 
            && (isTeacherPedagogicalUpdate() || isTeacherEvaluationUpdate())
          ) ||
          (
            isDirector() 
            && belongsToDaycare(resource.data.daycareId) 
            && (isDirectorPlanningReview() || isDirectorEvaluationReview() || isDirectorWeekClosure())
          )
        );
      
      allow delete: if false;

      // -----------------------------------------------------------------------
      // Review Observations Subcollection
      // -----------------------------------------------------------------------
      match /reviewObservations/{observationId} {
        
        function getParentPlan() {
          return get(/databases/$(database)/documents/weeklyPlannings/$(planningId)).data;
        }

        allow read: if isSignedIn() && (
          (isTeacher() && getParentPlan().teacherId == request.auth.uid) ||
          (isDirector() && belongsToDaycare(getParentPlan().daycareId)) ||
          (isSupervisor() && belongsToDaycare(getParentPlan().daycareId) && (getParentPlan().status in ['APPROVED', 'CLOSED']))
        );

        allow create: if isSignedIn() 
          && isDirector() 
          && belongsToDaycare(getParentPlan().daycareId)
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if isSignedIn()
          && isDirector()
          && belongsToDaycare(getParentPlan().daycareId)
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid;
          
        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Internal Connectivity
    // -------------------------------------------------------------------------
    // Fail closed as requested; emulator tests will prove access denial
    match /_internalConnectivityChecks/{documentId} {
      allow read, write: if false;
    }
  }
}
