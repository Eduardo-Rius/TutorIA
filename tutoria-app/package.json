{
  "name": "tutoria-core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node check-architecture.cjs",
    "test": "vitest --exclude src/infrastructure/firebase/__tests__/FirestoreRules.test.ts",
    "test:firestore-rules": "npx -y firebase-tools emulators:exec --project tutoria-rules-test --only firestore \"vitest run src/infrastructure/firebase/__tests__/FirestoreRules.test.ts\"",
    "lab:identity:dry-run": "node scripts/firebase/provisionIdentityLab.mjs",
    "lab:identity:provision": "node scripts/firebase/provisionIdentityLab.mjs --execute"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-admin": "^14.2.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vitest": "^3.0.4"
  }
}
